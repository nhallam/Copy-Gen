---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio">
  <main class="hero">
    <h1 class="hero-text">
      I am a product designer and recovering founder living in Brooklyn, NY.
    </h1>
  </main>
</Layout>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
  }

  .hero-text {
    font-family: 'American Grotesk Condensed', 'Arial Narrow', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 13vw, 8rem);
    line-height: 1.08;
    text-align: center;
    text-decoration: underline;
    text-underline-offset: 0.08em;
    text-decoration-thickness: 0.04em;
    letter-spacing: -0.01em;
  }
</style>
